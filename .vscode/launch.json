{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug zebrad",
      "type": "lldb",
      "request": "launch",

      "cargo": {
        "args": [
          "run",
          "--manifest-path",
          "${workspaceFolder}/zebra-crosslink/Cargo.toml",
          "--bin",
          "zebrad"
        ]
      },

      "args": [
        "-c",
        "${workspaceFolder}/../regtest.toml"
      ],

      "env": {
        "RUSTFLAGS": "-Awarnings"
      },

      "cwd": "${workspaceFolder}/zebra-crosslink",
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug zebrad without args",
      "type": "lldb",
      "request": "launch",

      "cargo": {
        "args": [
          "run",
          "--manifest-path",
          "${workspaceFolder}/zebra-crosslink/Cargo.toml",
          "--bin",
          "zebrad"
        ]
      },

      "env": {
        "RUSTFLAGS": "-Awarnings"
      },

      "cwd": "${workspaceFolder}/zebra-crosslink",
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug zebra-gui with fake data",
      "type": "lldb",
      "request": "launch",

      "cargo": {
        "args": [
          "run",
          "--manifest-path",
          "${workspaceFolder}/zebra-gui/Cargo.toml",
        ]
      },

      "args": [
        "-c",
        "${workspaceFolder}/../regtest.toml"
      ],

      "env": {
        "RUSTFLAGS": "-Awarnings"
      },

      "cwd": "${workspaceFolder}/zebra-gui",
      "sourceLanguages": ["rust"]
    }
  ]
}
